# ==============================================================================
# AegisLoom Security Lab — Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Security & CORS
# In production, specify your exact domain: https://training.aegisloom.example
CORS_ORIGIN=http://localhost:3000,http://localhost:4000,http://127.0.0.1:4000
ENFORCE_HTTPS=false

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://aegis_admin:AegisPassword123!@localhost:5432/aegisloom_training
DB_SSL=false
DB_POOL_MAX=20
DB_TIMEOUT_MS=5000

# Authentication & JWT Secrets (Change in Production!)
JWT_SECRET=super_secret_aegisloom_jwt_key_minimum_32_characters_random_hex
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=super_secret_aegisloom_refresh_jwt_key_minimum_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Multi-Factor Authentication (MFA / TOTP)
MFA_APP_NAME="AegisLoom Security Lab"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Optional Live Link Reputation (VirusTotal API v3)
# Never put this key in frontend JavaScript. Keep live checks disabled until a key is configured.
LINK_REPUTATION_ENABLED=false
VIRUSTOTAL_API_KEY=

# Audit Logging Level
LOG_LEVEL=info
