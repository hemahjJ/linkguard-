{
  "name": "aegisloom-security-lab-backend",
  "version": "1.0.0",
  "description": "Secure, educational phishing-awareness backend for AegisLoom Security Lab. Strictly zero credential harvesting.",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx migrations/migrate.ts",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "cybersecurity",
    "phishing-awareness",
    "security-training",
    "express",
    "typescript",
    "postgresql",
    "zero-trust"
  ],
  "author": "Rishi Jha",
  "license": "Apache-2.0",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
